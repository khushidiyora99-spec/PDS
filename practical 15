import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import binom, poisson

# -----------------------------------------
# 1. Binomial Distribution
# -----------------------------------------

n = 10          # Number of trials
p = 0.5         # Probability of success

x_binom = np.arange(0, n + 1)

# Calculate probability
binom_prob = binom.pmf(x_binom, n, p)

print("Binomial Probabilities:")
for x, prob in zip(x_binom, binom_prob):
    print(x, ":", prob)

# Plot Binomial distribution
plt.figure(figsize=(7, 4))
plt.bar(x_binom, binom_prob)
plt.title("Binomial Probability Distribution")
plt.xlabel("Number of Successes")
plt.ylabel("Probability")
plt.show()


# -----------------------------------------
# 2. Poisson Distribution
# -----------------------------------------

mu = 4         # Average number of events

x_poisson = np.arange(0, 15)

# Calculate probability
poisson_prob = poisson.pmf(x_poisson, mu)

print("\nPoisson Probabilities:")
for x, prob in zip(x_poisson, poisson_prob):
    print(x, ":", prob)

# Plot Poisson distribution
plt.figure(figsize=(7, 4))
plt.bar(x_poisson, poisson_prob)
plt.title("Poisson Probability Distribution")
plt.xlabel("Number of Events")
plt.ylabel("Probability")
plt.show()
