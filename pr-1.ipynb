# Variables and Data Types

print("===== VARIABLES AND DATA TYPES =====")

# Integer
a = 10

# Float
b = 5.5

# String
name = "Khushi"

# Boolean
flag = True

print("Integer:", a)
print("Float:", b)
print("String:", name)
print("Boolean:", flag)


# ==================================================
# ARITHMETIC OPERATORS
# ==================================================

print("\n===== ARITHMETIC OPERATORS =====")

print("Addition:", a + 5)
print("Subtraction:", a - 5)
print("Multiplication:", a * 5)
print("Division:", a / 5)
print("Floor Division:", a // 3)
print("Modulus:", a % 3)
print("Exponent:", a ** 2)


# ==================================================
# ASSIGNMENT OPERATORS
# ==================================================

print("\n===== ASSIGNMENT OPERATORS =====")

x = 10

x += 5
print("x += 5:", x)

x -= 2
print("x -= 2:", x)

x *= 2
print("x *= 2:", x)

x /= 2
print("x /= 2:", x)

x //= 2
print("x //= 2:", x)

x %= 3
print("x %= 3:", x)


# ==================================================
# COMPARISON OPERATORS
# ==================================================

print("\n===== COMPARISON OPERATORS =====")

p = 10
q = 20

print("p == q:", p == q)
print("p != q:", p != q)
print("p > q:", p > q)
print("p < q:", p < q)
print("p >= q:", p >= q)
print("p <= q:", p <= q)


# ==================================================
# LOGICAL OPERATORS
# ==================================================

print("\n===== LOGICAL OPERATORS =====")

print("AND:", p < q and q > 15)
print("OR:", p > q or q > 15)
print("NOT:", not(p > q))


# ==================================================
# MEMBERSHIP OPERATORS
# ==================================================

print("\n===== MEMBERSHIP OPERATORS =====")

numbers = [10, 20, 30, 40]

print("20 in numbers:", 20 in numbers)
print("50 in numbers:", 50 in numbers)
print("50 not in numbers:", 50 not in numbers)


# ==================================================
# IDENTITY OPERATORS
# ==================================================

print("\n===== IDENTITY OPERATORS =====")

list1 = [1, 2, 3]
list2 = list1
list3 = [1, 2, 3]

print("list1 is list2:", list1 is list2)
print("list1 is list3:", list1 is list3)
print("list1 is not list3:", list1 is not list3)


# ==================================================
# BITWISE OPERATORS
# ==================================================

print("\n===== BITWISE OPERATORS =====")

m = 5
n = 3

print("m & n:", m & n)
print("m | n:", m | n)
print("m ^ n:", m ^ n)
print("~m:", ~m)
print("m << 1:", m << 1)
print("m >> 1:", m >> 1)
