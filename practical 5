# TEXT FILE OPERATIONS

# Write operation
file = open("data.txt", "w")
file.write("Hello, Python!\n")
file.write("This is a text file.\n")
file.close()

# Read operation
file = open("data.txt", "r")
content = file.read()
print("File Content:")
print(content)
file.close()

# Append operation
file = open("data.txt", "a")
file.write("This line is added using append operation.\n")
file.close()

# Read again
file = open("data.txt", "r")
print("After Append:")
print(file.read())
file.close()
