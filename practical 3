# 3. if statement

print("--- IF STATEMENT ---")

age = 20

if age >= 18:
    print("You are eligible to vote")


# if-else statement

print("\n--- IF-ELSE ---")

number = 10

if number % 2 == 0:
    print("Even number")
else:
    print("Odd number")


# if-elif-else statement

print("\n--- IF-ELIF-ELSE ---")

marks = 75

if marks >= 90:
    print("Grade A+")
elif marks >= 80:
    print("Grade A")
elif marks >= 70:
    print("Grade B")
elif marks >= 60:
    print("Grade C")
else:
    print("Fail")


# While Loop

print("\n--- WHILE LOOP ---")

i = 1

while i <= 5:
    print(i)
    i += 1


# For Loop

print("\n--- FOR LOOP ---")

for i in range(1, 6):
    print(i)


# Nested Loop

print("\n--- NESTED LOOP ---")

for i in range(1, 4):
    for j in range(1, 4):
        print(i, j)


# Break

print("\n--- BREAK ---")

for i in range(1, 10):
    if i == 5:
        break
    print(i)


# Continue

print("\n--- CONTINUE ---")

for i in range(1, 6):
    if i == 3:
        continue
    print(i)


# Pass

print("\n--- PASS ---")

for i in range(1, 6):
    if i == 3:
        pass
    print(i)
