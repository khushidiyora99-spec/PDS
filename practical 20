import matplotlib.pyplot as plt
import numpy as np

# Sample data
x = np.array([1, 2, 3, 4, 5])
y = np.array([10, 25, 15, 30, 20])

students = ['A', 'B', 'C', 'D', 'E']
marks = [75, 85, 65, 90, 80]

data = [55, 60, 65, 70, 70, 75, 80, 85, 90, 95]

subjects = ['Python', 'Java', 'DBMS', 'CN']
values = [85, 75, 90, 80]

# Create figure and subplots
fig, ax = plt.subplots(2, 3, figsize=(14, 8))

# 1. Line Plot
ax[0, 0].plot(x, y, marker='o')
ax[0, 0].set_title("Line Plot")
ax[0, 0].set_xlabel("X Values")
ax[0, 0].set_ylabel("Y Values")
ax[0, 0].grid(True)

# 2. Bar Chart
ax[0, 1].bar(students, marks)
ax[0, 1].set_title("Bar Chart")
ax[0, 1].set_xlabel("Students")
ax[0, 1].set_ylabel("Marks")

# 3. Histogram
ax[0, 2].hist(data, bins=5, edgecolor='black')
ax[0, 2].set_title("Histogram")
ax[0, 2].set_xlabel("Marks")
ax[0, 2].set_ylabel("Frequency")

# 4. Pie Chart
ax[1, 0].pie(values, labels=subjects, autopct='%1.1f%%')
ax[1, 0].set_title("Pie Chart")

# 5. Scatter Plot
ax[1, 1].scatter(x, y)
ax[1, 1].set_title("Scatter Plot")
ax[1, 1].set_xlabel("X Values")
ax[1, 1].set_ylabel("Y Values")
ax[1, 1].grid(True)

# Empty sixth subplot
ax[1, 2].axis('off')

# Overall figure properties
fig.suptitle("Different Types of Matplotlib Plots",
             fontsize=18)

plt.tight_layout()
plt.show()
