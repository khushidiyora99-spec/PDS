import pandas as pd

# Create DataFrame
data = {
    'Name': ['Amit', 'Riya', 'Rahul', 'Neha', 'Karan'],
    'Age': [20, 21, 19, 22, 20],
    'Marks': [85, 92, 76, 88, 95],
    'City': ['Surat', 'Rajkot', 'Surat', 'Ahmedabad', 'Surat']
}

df = pd.DataFrame(data)

print("Original Data:")
print(df)

# 1. Slicing
print("\nSlicing:")
print(df.iloc[0:3, 0:3])

# 2. Filtering
print("\nFiltering Marks > 80:")
print(df[df['Marks'] > 80])

# 3. Sorting
print("\nSorting by Marks:")
print(df.sort_values(by='Marks', ascending=False))

# 4. Concatenating
df2 = pd.DataFrame({
    'Name': ['Pooja', 'Raj'],
    'Age': [21, 20],
    'Marks': [82, 89],
    'City': ['Vadodara', 'Surat']
})

combined = pd.concat([df, df2], ignore_index=True)

print("\nAfter Concatenation:")
print(combined)

# 5. Aggregation
print("\nAggregation:")
print("Average Marks:", df['Marks'].mean())
print("Maximum Marks:", df['Marks'].max())
print("Minimum Marks:", df['Marks'].min())
print("Total Students:", df['Name'].count())

# Group-wise aggregation
print("\nCity-wise Average Marks:")
print(df.groupby('City')['Marks'].mean())

# 6. Normalization using Min-Max Scaling
df['Marks_Normalized'] = (
    (df['Marks'] - df['Marks'].min()) /
    (df['Marks'].max() - df['Marks'].min())
)

print("\nAfter Normalization:")
print(df)
