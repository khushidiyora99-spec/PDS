from bs4 import BeautifulSoup

# Sample HTML document
html = """
<html>
<head>
    <title>Student Information</title>
</head>
<body>

    <h1>Student Details</h1>

    <div class="student">
        <h2>Khushi</h2>
        <p>Department: Computer Engineering</p>
        <p>Marks: 85</p>
    </div>

    <div class="student">
        <h2>Rahul</h2>
        <p>Department: Information Technology</p>
        <p>Marks: 90</p>
    </div>

    <table>
        <tr>
            <th>Name</th>
            <th>Marks</th>
        </tr>
        <tr>
            <td>Amit</td>
            <td>78</td>
        </tr>
        <tr>
            <td>Riya</td>
            <td>88</td>
        </tr>
    </table>

</body>
</html>
"""

# Parse HTML
soup = BeautifulSoup(html, "html.parser")

# 1. Extract page title
print("Page Title:")
print(soup.title.text)

# 2. Extract heading
print("\nHeading:")
print(soup.h1.text)

# 3. Extract all student names
print("\nStudent Names:")
for student in soup.find_all("h2"):
    print(student.text)

# 4. Extract all paragraphs
print("\nParagraphs:")
for p in soup.find_all("p"):
    print(p.text)

# 5. Extract table data
print("\nTable Data:")

table = soup.find("table")

for row in table.find_all("tr"):
    columns = row.find_all(["th", "td"])
    data = [column.text.strip() for column in columns]
    print(data)
